FROM eclipse-temurin:21-jdk-jammy@sha256:742daacb9316be4b6fc60258f6e4ac2a11882f6c597373c92290a57bfad0d2e0 AS build
COPY jars/ /runner/jars/
COPY GuestHarness.java /runner/GuestHarness.java
RUN javac --release 21 -cp '/runner/jars/*' -d /runner/classes /runner/GuestHarness.java
FROM eclipse-temurin:21-jdk-jammy@sha256:742daacb9316be4b6fc60258f6e4ac2a11882f6c597373c92290a57bfad0d2e0
COPY --from=build /runner/jars /runner/jars
COPY --from=build /runner/classes /runner/classes
USER 65532:65532
WORKDIR /tmp
ENTRYPOINT ["java"]
